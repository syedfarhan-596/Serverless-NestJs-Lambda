generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Users {
  id        Int       @unique @default(autoincrement())
  name      String
  email     String
  mobile    String
  createdAt DateTime  @default(now())
  updatedAt DateTime?
}
